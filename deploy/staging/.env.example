DATARUN_API_IMAGE=kaswarah/datarunapi:<version>-<commit>
DATARUN_STAGING_BIND_ADDRESS=0.0.0.0
DATARUN_STAGING_PORT=8080
STAGING_DATABASE_URL="jdbc:postgresql://192.168.1.221:5432/datarun_staging?sslmode=require&logServerErrorDetail=false"
STAGING_DATABASE_USERNAME=
STAGING_DATABASE_PASSWORD=
DATARUN_JWT_BASE64_SECRET=
# Monitoring through GlitchTip, each part off while empty. deploy-candidate.sh
# writes the staging .env without these, so staging reports nothing.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
DATARUN_ETL_HEARTBEAT_URL=
# Activation switches, each off unless true (docs/agent-context/api-v2.md).
DATARUN_ACTIVATION_CONFLICT_DETECTION=false
