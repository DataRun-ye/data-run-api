# Host environment for deploy/production/compose.yml on the API VM
# (datarun-prod.lab, /home/nmcp/datarun). Never commit real values.
#
# Pin an immutable image: kaswarah/datarunapi:<version>-<12-char-commit>.
# Never deploy "latest". Currently deployed: 6.4.1-40f176dde05b
DATARUN_API_IMAGE=kaswarah/datarunapi:6.4.1-<commit>

# Keep the existing value unchanged unless key rotation and forced
# reauthentication are the explicit purpose of a separate release.
DATARUN_JWT_BASE64_SECRET=

# Password for the least-privileged nmcpdb runtime role on the DB VM. It is
# generated into /etc/datarun-production/runtime-password and applied by
# provision-production-role.sql. It is NOT a PostgreSQL container variable.
NMCPDB_PASSWORD=
