<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!--
      Drops the twelve materialized views nothing reads, and analytics.mv_refresh_log, the empty log of the
      MaterializedViewRefresher removed in 8695335a.

      Production, measured for release 6.5.3: no code reads the views, no view depends on them, nothing reads them
      regularly. The owner confirmed that nothing outside DataRun reads the materialized views. On staging's production
      copy (2026-11-24) no view, function body, trigger or other object refers to any of them. The one dependency among
      them, _mv_assignments_info on _mv_org_unit_hierarchy_new_id, sets the order. No CASCADE: an unexpected dependent
      fails the deploy instead of going with them, and so does a lock held on them for more than lock_timeout.

      The role Liquibase connects as must own all of them, or the deploy fails. Staging is restored without owners, so
      only production can show this.

      Kept: analytics.dim_org_unit, analytics.dim_assignment, analytics.events_enriched and analytics.event_ancestors
      (the chain pivot builds read), analytics.translation_value() and analytics.pivot_manifest.

      Eight of the views come from changesets in analytics_dims/20251129-*.xml. Six of those changesets are runOnChange,
      so editing them would create their views again; 009, which made dim_org_unit_group and dim_org_unit_group_member,
      is not. dim_assignment_template, dim_org_unit_closure and the two public._mv_* views were made by hand and exist
      only where they were made, hence IF EXISTS.
    -->
    <changeSet id="20261124-04-drop-unread-materialized-views" author="datarun">
        <sql>SET LOCAL lock_timeout = '30s'</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS public._mv_assignments_info</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS public._mv_org_unit_hierarchy_new_id</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_activity</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_data_template</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_option</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_option_set</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_team</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_team_template_permission</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_assignment_template</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_org_unit_closure</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_org_unit_group</sql>
        <sql>DROP MATERIALIZED VIEW IF EXISTS analytics.dim_org_unit_group_member</sql>
        <sql>DROP TABLE IF EXISTS analytics.mv_refresh_log</sql>
        <rollback>
            <!--
              Empty on purpose. The hand-made views cannot be recreated from this repository, and recreating the
              others would only bring back views nothing reads. If one is ever needed, take its definition from a
              dump made before this changeset ran.
            -->
        </rollback>
    </changeSet>
</databaseChangeLog>
