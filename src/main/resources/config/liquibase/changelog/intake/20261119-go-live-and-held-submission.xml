<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet author="datarunapi" id="20261119-01-go-live-rule">
        <comment>
            When real data starts for a campaign (activity), optionally only in one org
            unit and everything under it and/or for one form (DataRun-ye/data-run-api#42).
            One rule per scope; GoLivePolicy decides which rule applies.
        </comment>
        <createTable tableName="go_live_rule">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_go_live_rule"/>
            </column>
            <column name="uid" type="varchar(11)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_go_live_rule_uid"/>
            </column>
            <column name="activity_uid" type="varchar(11)">
                <constraints nullable="false"/>
            </column>
            <column name="org_unit_uid" type="varchar(11)"/>
            <column name="form_uid" type="varchar(11)"/>
            <column name="live_from" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="text"/>
            <column name="last_modified_by" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            CREATE UNIQUE INDEX ux_go_live_rule_scope ON go_live_rule
                (activity_uid, (COALESCE(org_unit_uid, '')), (COALESCE(form_uid, '')));
        </sql>
        <rollback>
            <dropTable tableName="go_live_rule"/>
        </rollback>
    </changeSet>

    <changeSet author="datarunapi" id="20261119-02-held-submission">
        <comment>
            Uploads checked like real ones but kept out of the real data until an admin
            releases or discards them: practice uploads, and uploads started before their
            campaign's go-live (#42). payload is the upload exactly as received, so a
            release replays it through the normal upload path.
        </comment>
        <createTable tableName="held_submission">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_held_submission"/>
            </column>
            <column name="uid" type="varchar(11)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_held_submission_uid"/>
            </column>
            <column name="reason" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="activity_uid" type="varchar(11)"/>
            <column name="org_unit_uid" type="varchar(11)"/>
            <column name="org_unit_path" type="text"/>
            <column name="form_uid" type="varchar(11)"/>
            <column name="form_version_uid" type="varchar(11)"/>
            <column name="team_uid" type="varchar(11)"/>
            <column name="assignment_uid" type="varchar(11)"/>
            <column name="submitted_by" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="timestamptz"/>
            <column name="received_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="go_live_rule_uid" type="varchar(11)"/>
            <column name="live_from" type="timestamptz"/>
            <column name="payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="decided_by" type="varchar(100)"/>
            <column name="decided_at" type="timestamptz"/>
            <column name="note" type="text"/>
            <column name="last_release_error" type="text"/>
            <column name="last_modified_date" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="held_submission" indexName="idx_held_submission_activity_state">
            <column name="activity_uid"/>
            <column name="state"/>
        </createIndex>
        <rollback>
            <dropTable tableName="held_submission"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
