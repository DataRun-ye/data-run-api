<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet author="datarunapi" id="20261118-01-user-last-seen-client">
        <comment>
            The app each user last used: the X-App-Version a phone reports, and the
            referenceVersion of the user's last assignments sync (0 = apps before 6.0.2).
        </comment>
        <addColumn tableName="user_last_seen">
            <column name="app_version" type="varchar(32)"/>
            <column name="reference_version" type="integer"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
