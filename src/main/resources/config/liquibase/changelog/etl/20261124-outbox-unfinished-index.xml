<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!--
      The outbox rows the ETL has not finished with (pending, failed, dead), in claim order. The ETL's due check,
      its claim and its backlog gauges read only these rows; without the index each of them reads the whole outbox,
      which keeps every row it was ever sent.

      Built concurrently, so writes to the outbox go on meanwhile; that cannot run in a transaction. A concurrent
      build that failed leaves an invalid index of the same name, so the changeset runs while no valid one exists,
      drops a leftover first, and can be run again.

      Rollback drops the index; nothing depends on it but query speed.
    -->
    <changeSet id="20261124-01-outbox-unfinished-index" author="datarun" runInTransaction="false">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*)
                FROM pg_index i
                JOIN pg_class c ON c.oid = i.indexrelid
                WHERE c.relname = 'idx_outbox_unfinished' AND i.indisvalid
            </sqlCheck>
        </preConditions>
        <sql>DROP INDEX CONCURRENTLY IF EXISTS idx_outbox_unfinished</sql>
        <sql>
            CREATE INDEX CONCURRENTLY idx_outbox_unfinished
                ON outbox (submission_serial_number, outbox_id)
                WHERE status IN ('pending', 'failed', 'dead')
        </sql>
        <rollback>
            <sql>DROP INDEX CONCURRENTLY IF EXISTS idx_outbox_unfinished</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
