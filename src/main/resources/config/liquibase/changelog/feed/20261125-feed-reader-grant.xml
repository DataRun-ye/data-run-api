<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!--
      Downstream's reading role. Empty here, so nothing is granted; a Liquibase parameter of the same name overrides it.
      The application passes the setting datarun.feed.reader-role (DATARUN_FEED_READER_ROLE), and only a plain role
      name (letters, digits, _ and -, at most 63 characters; FeedReaderRole), so the name can be quoted below as is.
    -->
    <property name="feedReaderRole" value=""/>

    <!--
      Read access to the feed for downstream's Airbyte role (contract 10 and 13): USAGE on schema feed, SELECT on its
      tables, and default privileges, so that a stream added later is readable at once. Nothing more: the role cannot
      write, and it gets nothing on feed_ops, the publisher's bookkeeping, nor on the position sequence.

      The role's name is not known when this ships, so the grant follows the setting. The precondition holds only when
      the configured role exists; while it does not (no name set, or a name whose role does not exist), the changeset
      is marked ran and grants nothing (onFail MARK_RAN), so nothing is ever left pending. runOnChange: the name is part
      of the changeset's text, so its checksum changes with the setting, and the first start after the setting names a
      role, or another one, runs it again and grants that role; a role named earlier keeps its grants. A role named
      before it exists is not granted when it is created later, since the setting did not change: grant it by hand,
      with the three statements below, or restart once with the setting empty and once with it set again. The
      application logs a WARN at every start while downstream cannot read the feed (FeedReaderGrantCheck).

      A run, or a run again, records itself as the latest changeset run, so the journal's gap repair, which runs after
      it, reads every submission at that start, as at any start that applies a changeset.

      Rollback revokes the three grants from the configured role, if that role exists. Dropping schema feed
      (20261125-d01's rollback) removes them in any case.
    -->
    <changeSet id="20261125-d02-feed-reader-grant" author="datarun" runOnChange="true">
        <preConditions onFail="MARK_RAN"
                       onFailMessage="Downstream's reader role is not set (datarun.feed.reader-role) or does not exist: schema feed is not granted">
            <sqlCheck expectedResult="1">SELECT count(*) FROM pg_roles WHERE rolname = '${feedReaderRole}'</sqlCheck>
        </preConditions>
        <sql>GRANT USAGE ON SCHEMA feed TO "${feedReaderRole}"</sql>
        <sql>GRANT SELECT ON ALL TABLES IN SCHEMA feed TO "${feedReaderRole}"</sql>
        <sql>ALTER DEFAULT PRIVILEGES IN SCHEMA feed GRANT SELECT ON TABLES TO "${feedReaderRole}"</sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                DO $$
                BEGIN
                    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '${feedReaderRole}') THEN
                        EXECUTE format('ALTER DEFAULT PRIVILEGES IN SCHEMA feed REVOKE SELECT ON TABLES FROM %I',
                                       '${feedReaderRole}');
                        EXECUTE format('REVOKE SELECT ON ALL TABLES IN SCHEMA feed FROM %I', '${feedReaderRole}');
                        EXECUTE format('REVOKE USAGE ON SCHEMA feed FROM %I', '${feedReaderRole}');
                    END IF;
                END $$
            ]]></sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
